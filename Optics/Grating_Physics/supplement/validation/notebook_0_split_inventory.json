      "source_sha256": "b77158157b761d651269d26c3236a266a5aec5142406471fcf8754bbfe3d3278",
      "math": [],
      "code": "from pathlib import Path\nimport sys\nimport importlib\nfrom IPython.display import display\n\n_support_dir = next((base for base in (Path.cwd().resolve(), *Path.cwd().resolve().parents)\n    if (base / 'wave_optics' / '__init__.py').is_file()), None)\nif _support_dir is None:\n    raise FileNotFoundError('Open this notebook within the Grating_Physics folder.')\nif str(_support_dir) not in sys.path:\n    sys.path.insert(0, str(_support_dir))\n\n# Release current explorers and any remaining objects from earlier notebook versions.\nfor _name in ('absorber_comparison', 'binary_masks', 'grating_comparison'):\n    if _name in globals():\n        globals()[_name].close()\nif 'grating_views' in globals():\n    for previous in grating_views.values():\n        previous.close()\n\n# Refresh dependencies before their consumers, including a cached pre-absorber solver.\n# Import and reload one module at a time: importing all first can fail on new symbols.\nfor _module_name in ('scalar_grating', 'binary_transmission', 'thin_grating',\n                     'absorbing_grating', 'scalar_grating_view', 'amplitude_grating',\n                     'grating_comparison_view', 'absorbing_grating_view'):\n    importlib.reload(importlib.import_module(f'wave_optics.{_module_name}'))\n\nimport wave_optics.absorbing_grating as absorbing_model\nimport wave_optics.scalar_grating_view as grating_view\nimport wave_optics.amplitude_grating as amplitude_model\nimport wave_optics.absorbing_grating_view as absorbing_view\n\n# One shared physical absorber: centred air opening, air half-spaces.\n# Compute 49 harmonics; display only orders -7,...,+7 in coefficient plots.\ngrating_config = absorbing_model.AbsorbingGratingConfiguration(M=24)\ndisplay_order_limit = 7\ngrating_solution = absorbing_model.solve_absorbing_grating(grating_config)\ngrating_data = grating_view.ScalarGratingData(grating_solution)\ngrating_views = {}\n\ndef show_grating(stage):\n    if stage in grating_views:\n        grating_views[stage].close()\n    grating_views[stage] = grating_view.ScalarGratingExplorer(\n        stage, grating_data, display_order_limit=display_order_limit)\n    display(grating_views[stage].ui)\n",
      "links": []
    },
